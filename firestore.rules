rules_version = '2';

// Firestore security rules for the Risk Awareness Platform.
//
// Roles live on users/{uid}.role:
//   admin    – platform operator. Never self-assigned; set it in the Firebase
//              console (see README, "Create the first admin").
//   company  – manages one company (users/{uid}.companyId).
//   employee – belongs to one company and takes assessments.
//
// Join codes are looked up through joinCodes/{code} with a single-document
// get. Companies themselves cannot be listed, so codes cannot be harvested.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function me() {
      return get(profilePath(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasProfile() && me().role == 'admin';
    }

    function isCompanyAdminOf(companyId) {
      return hasProfile() && me().role == 'company' && me().companyId == companyId;
    }

    function isMemberOf(companyId) {
      return hasProfile() && me().companyId == companyId;
    }

    function companyAdminUid(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.adminUid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Users ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isCompanyAdminOf(resource.data.companyId)
      );

      // Company admins list their own employees; admins list everyone.
      allow list: if isAdmin()
        || (hasProfile() && me().role == 'company' && resource.data.companyId == me().companyId);

      // Sign-up. Nobody can create an admin profile, a company profile must
      // point at a company this user created, and an employee profile must
      // carry a join code that belongs to the company it names.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['company', 'employee']
        && (
          (request.resource.data.role == 'company'
            && companyAdminUid(request.resource.data.companyId) == request.auth.uid)
          ||
          (request.resource.data.role == 'employee'
            && request.resource.data.joinCode is string
            && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.companyId
               == request.resource.data.companyId)
        );

      allow update: if isAdmin()
        // Users edit their own profile but never their role or company.
        || (signedIn() && request.auth.uid == userId
            && !changedKeys().hasAny(['role', 'companyId', 'joinCode', 'email']))
        // Company admins can only remove an employee from their company.
        || (isCompanyAdminOf(resource.data.companyId)
            && resource.data.role == 'employee'
            && changedKeys().hasOnly(['companyId'])
            && request.resource.data.companyId == null);

      allow delete: if isAdmin();
    }

    // ── Companies ───────────────────────────────────────────────────────────

    match /companies/{companyId} {
      allow get: if isAdmin()
        || isMemberOf(companyId)
        // The creator reads it during sign-up, before their profile exists.
        || (signedIn() && resource.data.adminUid == request.auth.uid);

      allow list: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.joinCode is string;

      allow update: if isAdmin()
        || (isCompanyAdminOf(companyId) && !changedKeys().hasAny(['adminUid', 'joinCode']));

      allow delete: if isAdmin();

      match /employees/{employeeId} {
        allow get, list: if isAdmin() || isCompanyAdminOf(companyId)
          || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if (isAdmin() || isCompanyAdminOf(companyId))
          && request.resource.data.companyId == companyId;
        allow update: if isAdmin() || isCompanyAdminOf(companyId);
        allow delete: if isAdmin() || isCompanyAdminOf(companyId);
      }

      match /reports/{reportId} {
        allow get, list: if isAdmin() || isCompanyAdminOf(companyId);
        allow create, update, delete: if isAdmin();
      }
    }

    // ── Join codes ──────────────────────────────────────────────────────────
    //
    // joinCodes/{code} = { companyId }. Anyone can check one code (that is how
    // an employee joins), nobody can list them, and only the company's own
    // admin can create the code for it.

    match /joinCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['companyId'])
        && companyAdminUid(request.resource.data.companyId) == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && companyAdminUid(resource.data.companyId) == request.auth.uid);
    }

    // ── Questions and settings ──────────────────────────────────────────────

    match /questions/{questionId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Assessment attempts ─────────────────────────────────────────────────
    //
    // Rules are not filters: a query must ask only for documents the user may
    // read. Employees query where('userId', '==', uid); admins query freely.

    match /assessment_attempts/{attemptId} {
      allow get: if signedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || isCompanyAdminOf(resource.data.companyId)
      );
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.companyId == '' || isMemberOf(request.resource.data.companyId));
      // Attempts are a record: never edited or deleted from the client.
      allow update, delete: if false;
    }
  }
}
