# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. It is already in .gitignore.

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Gemini API key for the AI tutor, explanations and DPDP chatbot
# (https://aistudio.google.com/apikey). Server-side only: never prefix it
# with NEXT_PUBLIC_, or it is shipped to every visitor's browser.
GOOGLE_API_KEY=your-gemini-api-key
